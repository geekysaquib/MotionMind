PORT=8787
WEB_ORIGIN=http://localhost:5173
# "supabase" (real) or "memory" (local demo: in-memory keys, dev tokens; never use in production)
API_DATA_MODE=supabase
SUPABASE_URL=https://dxmtfsmdfncrrwwcxpzj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_SECRET=

# Signs sign-in sessions and hashes login codes. 32 random bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Sign-in code email over SMTP. Gmail: smtp.gmail.com, port 465, your Gmail address, and an App Password
# (Google Account > Security > 2-Step Verification > App passwords). Leave SMTP_HOST empty to print codes in this terminal.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional, defaults to SMTP_USER. Example: Motion Mind <you@gmail.com>
SMTP_FROM=

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    // One package.json for the whole repo: shared code is reached through this alias
    // (also set in frontend/vite.config.ts and jest.config.js).
    "paths": {
      "@motionmind/shared": ["./shared/src/index.ts"]
    }
  }
}

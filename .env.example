# Motion Mind: one env file for the web app, the API and the reel engine.
# Copy to .env in the repo root and fill it in. Never commit .env.

# ---------- API server ----------
PORT=8787
WEB_ORIGIN=http://localhost:5173
# "supabase" (real) or "memory" (local demo: in-memory keys, dev tokens; never use in production)
API_DATA_MODE=supabase
SUPABASE_URL=https://dxmtfsmdfncrrwwcxpzj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Claude for every user: writes reel scripts and answers Ask Claude. Users never add keys.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Signs sign-in sessions and hashes login codes. 32 random bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Sign-in code email over SMTP. Gmail: smtp.gmail.com, port 465, your Gmail address, and an App Password
# (Google Account > Security > 2-Step Verification > App passwords). Leave SMTP_HOST empty to print codes in this terminal.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional, defaults to SMTP_USER. Example: Motion Mind <you@gmail.com>
SMTP_FROM=

# ---------- Web app (Vite). Only VITE_* values reach the browser, so never put secrets in them. ----------
# "api" for real accounts (email code sign-in through the Motion Mind API),
# or "memory" for a local demo (data stays in this browser, clearly labelled in the UI)
VITE_DATA_MODE=api

# ---------- ElevenLabs: voiceover for every user (API + npm run reel:tts) ----------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Raw footage editing (Edit raw footage). FFmpeg and yt-dlp are found on PATH; set these only to point elsewhere.
# Captions need whisper.cpp: WHISPER_CPP_BIN = path to whisper-cli(.exe), WHISPER_MODEL = path to a ggml model (e.g. ggml-base.bin).
# FOOTAGE_DIR is where uploaded clips and exports are kept (default: footage/ at the repo root).
FOOTAGE_DIR=
FFMPEG_BIN=
FFPROBE_BIN=
WHISPER_CPP_BIN=
WHISPER_MODEL=
YTDLP_BIN=

{
  "name": "motion-mind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite frontend",
    "dev:api": "tsx watch --tsconfig backend/tsconfig.json --env-file=.env backend/src/server.ts",
    "start:api": "tsx --tsconfig backend/tsconfig.json --env-file=.env backend/src/server.ts",
    "preview:web": "vite preview frontend",
    "build": "npm run typecheck && vite build frontend",
    "typecheck": "tsc -p shared --noEmit && tsc -p backend --noEmit && tsc -p frontend --noEmit",
    "test": "vitest run",
    "reel:tts": "cd backend/reel-engine && node --env-file-if-exists=../../.env tts.mjs",
    "reel:render": "cd backend/reel-engine && node render.mjs"
  },
  "dependencies": {
    "@fastify/cors": "10.1.0",
    "@fontsource-variable/google-sans": "^5.3.2",
    "@fontsource/inter": "5.1.1",
    "@fontsource/jetbrains-mono": "5.1.1",
    "@fontsource/space-grotesk": "5.1.1",
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@supabase/supabase-js": "2.118.0",
    "fastify": "5.12.8",
    "lucide-react": "0.460.0",
    "mobx": "6.16.1",
    "mobx-react-lite": "4.1.1",
    "nodemailer": "6.9.16",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "remotion": "4.0.540",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "22.9.0",
    "@types/nodemailer": "6.4.17",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}

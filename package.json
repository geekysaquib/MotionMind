{
  "name": "motion-mind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite frontend",
    "dev:api": "tsx watch --tsconfig backend/tsconfig.json --env-file=.env backend/src/server.ts",
    "start:api": "tsx --tsconfig backend/tsconfig.json --env-file=.env backend/src/server.ts",
    "preview:web": "vite preview frontend",
    "build": "npm run typecheck && vite build frontend",
    "typecheck": "tsc -p shared --noEmit && tsc -p backend --noEmit && tsc -p frontend --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "dependencies": {
    "@fastify/cors": "10.1.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/google-sans": "^5.3.2",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "fastify": "5.12.8",
    "gsap": "3.13.0",
    "hyperframes": "0.9.17",
    "lucide-react": "0.460.0",
    "mobx": "6.16.1",
    "mobx-react-lite": "4.1.1",
    "nodemailer": "6.9.16",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@swc/core": "^1.10.1",
    "@swc/jest": "^0.2.37",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.9.0",
    "@types/nodemailer": "6.4.17",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vite": "5.4.21"
  }
}

PORT=8787
WEB_ORIGIN=http://localhost:5173
# "supabase" (real) or "memory" (local demo: in-memory keys, dev tokens; never use in production)
API_DATA_MODE=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_SECRET=
